# Exclude raw dataset files & TSVs (1.5 GB+)
dataset/train/*.tsv
dataset/test/*.tsv
dataset/**/*.tsv
*.tsv
**/*.tsv

# Exclude generated outputs, normalized data, and test scratch
output/
output_test/
data/
scratch/

# Exclude Python environment & cache
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
